# Pooled/Supavisor Postgres connection string from the Supabase dashboard
# (Project Settings > Database > Connection pooling > Connection string).
# This service connects directly to Postgres, bypassing PostgREST/RLS, so
# it MUST use a role scoped for this purpose (see README's "Access control"
# section) rather than the raw postgres superuser.
DATABASE_URL=postgres://user:password@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# Schema the app's tables live in.
DB_SCHEMA=hostiggo_testing_schema

PORT=8080
DB_MAX_CONNS=10
QUERY_TIMEOUT_MS=10000

# CORS: origin allowed to call this API from a browser. "*" (default) is
# fine while this stays a fully public/anonymous API, same as the original
# Supabase anon-key search path — tighten to the real frontend origin (e.g.
# https://app.hostiggo.com) once known. Set to empty to disable CORS headers
# entirely (same-origin deployments only).
CORS_ALLOW_ORIGIN=*

# Set to 1 to disable the embedded manual test console at "/" (recommended
# for a real deployment; leave unset for local testing).
DISABLE_TEST_UI=
